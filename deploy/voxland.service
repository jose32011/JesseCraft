[Unit]
Description=Voxland game server
After=network-online.target postgresql@18-main.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/voxland/current
EnvironmentFile=/root/JesseCraft/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=POKEMON_DATA_DIR=/var/lib/voxland/pokemon-arena
StateDirectory=voxland
ExecStart=/usr/bin/node JesseArcade/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
